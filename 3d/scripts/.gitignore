# Ignore everything by default
*
*/

# Allow-list: only track script-related files
!.gitignore
!*.py
!*.sh
!*.js
!*.json
!*.blend
!*.md
!*.txt
!LICENSE
!CHANGELOG*

# Keep directory structure
!*/

# Reject archive folders and their contents (overrides allow-list above)
_ARCHIVE/
*/_ARCHIVE/
**/_ARCHIVE/**
